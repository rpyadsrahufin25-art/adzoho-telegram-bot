# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Super Admin Password (Owner - full access, settings, passwords, export, broadcast)
SUPER_ADMIN_PASSWORD=ADZOHO_SUPER_2026

# Normal Admin Password (Staff / Team - stats, leads, search, follow-ups)
NORMAL_ADMIN_PASSWORD=ADZOHO_ADMIN_2026

# Official Telegram Support username (without @)
TELEGRAM_SUPPORT_USERNAME=Adzoho

# WhatsApp contact link
WHATSAPP_LINK=https://wa.me/YOUR_PHONE_NUMBER

# Database path
DATABASE_PATH=adzoho_bot.db

# Logging level
LOG_LEVEL=INFO
